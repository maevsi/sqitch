	legal_term_88bea21	[height=3.6806,
		label=<
      <table border="1" cellborder="0" cellspacing="0" color="#888888">
	<tr>
		<td colspan='2' bgcolor='#C2D0F2' align='left'><b><i>vibetype.legal_term</i></b></td>
		<td bgcolor='#C2D0F2' align='right'>[table]</td>
	</tr>
	<tr>
		<td colspan='3' align='left'>@behavior -insert -update -delete
Legal terms like privacy policies or terms of service.</td>
	</tr>
	<tr>
		<td port='id_8f1671a.start' align='left'><b><i>id</i></b></td>
		<td align='left'> </td>
		<td port='id_8f1671a.end' align='left'>uuid not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Unique identifier for each legal term.</td>
	</tr>
	<tr>
		<td port='language_a8c3ed57.start' align='left'>"language"</td>
		<td align='left'> </td>
		<td port='language_a8c3ed57.end' align='left'>varchar(5) not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Language code in ISO 639-1 format with optional region (e.g., `en` for English, `en_GB` for British English)</td>
	</tr>
	<tr>
		<td port='term_9279e6b.start' align='left'>term</td>
		<td align='left'> </td>
		<td port='term_9279e6b.end' align='left'>text not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Text of the legal term. Markdown is expected to be used. It must be non-empty and cannot exceed 500,000 characters.</td>
	</tr>
	<tr>
		<td port='version_1de676d7.start' align='left'>version</td>
		<td align='left'> </td>
		<td port='version_1de676d7.end' align='left'>varchar(20) not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Semantic versioning string to track changes to the legal terms (format: `X.Y.Z`).</td>
	</tr>
	<tr>
		<td port='created_at_5a9502e9.start' align='left'>created_at</td>
		<td align='left'> </td>
		<td port='created_at_5a9502e9.end' align='left'>timestamptz not null</td>
	</tr>
	<tr>
		<td align='left'></td>
