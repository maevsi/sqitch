	email_3708fbc7	[height=6.0417,
		label=<
      <table border="1" cellborder="0" cellspacing="0" color="#888888">
	<tr>
		<td colspan='2' bgcolor='#F2C2D6' align='left'><b><i>vibetype_private.email</i></b></td>
		<td bgcolor='#F2C2D6' align='right'>[table]</td>
	</tr>
	<tr>
		<td colspan='3' align='left'>Tracks email addresses with a deliverability issue: hard bounces, spam complaints, or explicit unsubscribes.</td>
	</tr>
	<tr>
		<td port='id_aa168a34.start' align='left'><b><i>id</i></b></td>
		<td align='left'> </td>
		<td port='id_aa168a34.end' align='left'>uuid not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Unique row identifier.</td>
	</tr>
	<tr>
		<td port='address_65ae190d.start' align='left'>address</td>
		<td align='left'> </td>
		<td port='address_65ae190d.end' align='left'>text not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>The affected email address. At most 254 characters (RFC 5321).</td>
	</tr>
	<tr>
		<td port='address_hash_b9d1b392.start' align='left'>address_hash</td>
		<td align='left'> </td>
		<td port='address_hash_b9d1b392.end' align='left'>text</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'></td>
		<td align='left'>generated</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Lowercased version of the address, generated for case-insensitive lookups.</td>
	</tr>
	<tr>
		<td port='status_74e44d0b.start' align='left'>status</td>
		<td align='left'> </td>
		<td port='status_74e44d0b.end' align='left'>email_status not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>'active', bounced', complained', unsubscribed'</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>The deliverability status: active (no issue), bounced (hard/permanent bounce reported by SES), complained (spam complaint reported by SES), or unsubscribed (explicit user opt-out).</td>
	</tr>
	<tr>
		<td port='reason_725c0f5d.start' align='left'>reason</td>
		<td align='left'> </td>
		<td port='reason_725c0f5d.end' align='left'>text</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Optional human-readable reason (e.g. bounce subtype or complaint feedback type). At most 512 characters.</td>
	</tr>
	<tr>
		<td port='created_at_fbba2603.start' align='left'>created_at</td>
		<td align='left'> </td>
		<td port='created_at_fbba2603.end' align='left'>timestamptz not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Timestamp when this status was first recorded.</td>
	</tr>
	<tr>
		<td port='updated_at_987a0f50.start' align='left'>updated_at</td>
		<td align='left'> </td>
		<td port='updated_at_987a0f50.end' align='left'>timestamptz</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Timestamp when this status was last updated.</td>
	</tr>
	<tr>
		<td port='updated_by_987a0f74.start' align='left'>updated_by</td>
		<td align='left'> </td>
		<td port='updated_by_987a0f74.end' align='left'>uuid</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>Account that last updated this row, or NULL for service-triggered updates.</td>
	</tr>
      </table>
    >,
