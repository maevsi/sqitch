	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>@behavior -insert
Unique identifier for this legal term acceptance record. Automatically generated for each new acceptance.</td>
	</tr>
	<tr>
		<td port='account_id_2baab85a.start' align='left'>account_id</td>
		<td align='left'> </td>
		<td port='account_id_2baab85a.end' align='left'>uuid not null</td>
