	attendance_571666d8	[height=5.4514,
		label=<
      <table border="1" cellborder="0" cellspacing="0" color="#888888">
	<tr>
		<td colspan='2' bgcolor='#C2D0F2' align='left'><b><i>vibetype.attendance</i></b></td>
		<td bgcolor='#C2D0F2' align='right'>[table]</td>
	</tr>
	<tr>
		<td colspan='3' align='left'>@behavior -delete
Keeps track of when someone arrives and leaves an event. Each person can only be checked in once.</td>
	</tr>
	<tr>
		<td port='id_8bb68143.start' align='left'><b><i>id</i></b></td>
		<td align='left'> </td>
		<td port='id_8bb68143.end' align='left'>uuid not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>@behavior -insert -update
A unique reference for this entry.</td>
	</tr>
	<tr>
		<td port='checked_out_d753f6de.start' align='left'>checked_out</td>
		<td align='left'> </td>
		<td port='checked_out_d753f6de.end' align='left'>bool</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>@behavior -insert
Shows if the person has left. When this turns on, the time is saved automatically.</td>
	</tr>
	<tr>
		<td port='contact_id_940ccdc2.start' align='left'>contact_id</td>
		<td align='left'> </td>
		<td port='contact_id_940ccdc2.end' align='left'>uuid</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>@behavior -update
The contact information available to anyone with access to this attendance entry. This may differ from the guest information if the guest provided different details at check-in.</td>
	</tr>
	<tr>
		<td port='guest_id_376cc90a.start' align='left'>guest_id</td>
		<td align='left'> </td>
		<td port='guest_id_376cc90a.end' align='left'>uuid not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>@behavior -update
Who this entry is for.</td>
	</tr>
	<tr>
		<td port='created_at_dd5a1d12.start' align='left'>created_at</td>
		<td align='left'> </td>
		<td port='created_at_dd5a1d12.end' align='left'>timestamptz not null</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>@behavior -insert -update
When the entry was created (the check-in time).</td>
	</tr>
	<tr>
		<td port='updated_at_7a1a065f.start' align='left'>updated_at</td>
		<td align='left'> </td>
		<td port='updated_at_7a1a065f.end' align='left'>timestamptz</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>@behavior -insert -update
When this entry was last changed. If someone checks out, this shows the checkout time.</td>
	</tr>
	<tr>
		<td port='updated_by_7a1a0683.start' align='left'>updated_by</td>
		<td align='left'> </td>
		<td port='updated_by_7a1a0683.end' align='left'>uuid</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>@behavior -insert -update
Who last changed this entry. This may be empty if done without signing in.</td>
	</tr>
	<tr>
		<td port='tag_serial_number_9c28b037.start' align='left'>tag_serial_number</td>
		<td align='left'> </td>
		<td port='tag_serial_number_9c28b037.end' align='left'>text</td>
	</tr>
	<tr>
		<td align='left'></td>
		<td align='left'> </td>
		<td align='left'>The serial number of the physical tag written for this entry, which tells a tag apart from a copy that carries the same link.</td>
	</tr>
      </table>
    >,
		pos="10358,3821",
		width=21.309];
