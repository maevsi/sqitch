	</tr>
	<tr>
		<td port='created_at_dd5a1d12.start' align='left'>created_at</td>
		<td align='left'> </td>
		<td port='created_at_dd5a1d12.end' align='left'>timestamptz not null</td>
	</tr>
	<tr>
		<td align='left'></td>
